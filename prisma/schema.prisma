generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
}

enum PrayerType {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
  JUMUAH
  TARAWIH
  EID_FITR
  EID_ADHA
}

enum PrayerCategory {
  DAILY
  WEEKLY
  RAMADAN
  EID
}

enum PrayerQuizStatus {
  PENDING
  PASSED
  FAILED
  EXPIRED
}

enum StreakFreezeReason {
  USER_INITIATED
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  username      String          @unique
  avatar        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // auth relations
  credentials   UserCredential?
  refreshTokens RefreshToken[]

  // gamification relations
  xp            UserXp?
  streak        UserStreak?

  // follow relations
  following     Follow[]        @relation("UserFollowing")
  followers     Follow[]        @relation("UserFollowers")

  // avatar customization
  avatarConfig    UserAvatarConfig?

  // consent records
  consents        UserConsent[]

  // prayer relations
  prayerCompletions   PrayerCompletion[]
  prayerQuizzes       PrayerQuizSubmission[]
  prayerStats         UserPrayerStats?
  streakFreezeUsages  StreakFreezeUsage[]

  @@map("users")
}



model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

//////////////////////////////////////////////////////

model UserCredential {
  id                 String    @id @default(uuid())
  userId             String    @unique
  passwordHash       String
  passwordUpdatedAt  DateTime  @default(now())
  createdAt          DateTime  @default(now())

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

//////////////////////////////////////////////////////

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  isRevoked   Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

//////////////////////////////////////////////////////

model OtpVerification {
  id                   String   @id @default(uuid())
  tokenHash            String   @unique
  otpCode              String
  otpExpiresAt         DateTime
  email                String
  username             String
  passwordHash         String
  termsVersion         String
  privacyPolicyVersion String
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@map("otp_verifications")
}

//////////////////////////////////////////////////////

model UserConsent {
  id          String      @id @default(uuid())
  userId      String
  type        ConsentType
  version     String
  acceptedAt  DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, version])
  @@index([userId])
  @@index([userId, type, acceptedAt])
  @@map("user_consents")
}

//////////////////////////////////////////////////////

model PasswordReset {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  failedAttempts Int  @default(0)
  isUsed     Boolean  @default(false)

  @@index([userId])
  @@map("password_resets")
}

//////////////////////////////////////////////////////

model UserAvatarConfig {
  id           String   @id @default(uuid())
  userId       String   @unique
  gender       Gender   @default(MALE)
  colors       Json     @default("{}")
  accessories  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatar_configs")
}

//////////////////////////////////////////////////////

model UserXp {
  id         String   @id @default(uuid())
  userId     String   @unique
  xp         Int      @default(0)
  totalXp    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([xp])
  @@map("user_xp")
}

//////////////////////////////////////////////////////

model UserStreak {
  id                String   @id @default(uuid())
  userId            String   @unique
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  streakFreezeCount Int      @default(0)
  lastActiveDate    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentStreak])
  @@map("user_streaks")
}

//////////////////////////////////////////////////////

model Question {
  id            String   @id @default(uuid())
  guideId       String
  question      String
  options       String[]
  correctAnswer String
  difficulty    Int?
  createdAt     DateTime @default(now())

  @@index([guideId])
  @@map("questions")
}

//////////////////////////////////////////////////////

model PrayerQuestion {
  id           String       @id @default(uuid())
  prompt       String
  explanation  String?
  prayerType   PrayerType?
  difficulty   Int          @default(1)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  options      PrayerQuestionOption[]

  @@index([prayerType, isActive])
  @@index([isActive])
  @@map("prayer_questions")
}

//////////////////////////////////////////////////////

model PrayerQuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  text        String
  isCorrect   Boolean  @default(false)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  question    PrayerQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("prayer_question_options")
}

//////////////////////////////////////////////////////

model PrayerQuizSubmission {
  id                  String           @id @default(uuid())
  userId              String
  prayerType          PrayerType
  prayerDate          DateTime         @db.Date
  timezone            String
  questionIds         String[]
  windowStartsAt      DateTime
  windowEndsAt        DateTime
  expiresAt           DateTime
  status              PrayerQuizStatus @default(PENDING)
  attemptCount        Int              @default(0)
  submittedAt         DateTime?
  prayerCompletionId  String?          @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  prayerCompletion    PrayerCompletion?   @relation(fields: [prayerCompletionId], references: [id], onDelete: SetNull)

  @@index([userId, prayerDate])
  @@index([userId, status])
  @@index([userId, prayerType, prayerDate])
  @@map("prayer_quiz_submissions")
}

model PrayerCompletion {
  id                  String          @id @default(uuid())
  userId              String
  prayerType          PrayerType
  prayerDate          DateTime        @db.Date
  completedAt         DateTime        @default(now())
  timezone            String
  xpAwarded           Int
  isFirstOfDay        Boolean         @default(false)
  streakContributed   Boolean         @default(false)
  streakFreezeApplied Boolean         @default(false)
  createdAt           DateTime        @default(now())
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizSubmission      PrayerQuizSubmission?

  @@unique([userId, prayerType, prayerDate])
  @@index([userId, prayerDate])
  @@index([userId, completedAt])
  @@map("prayer_completions")
}

model UserPrayerStats {
  id              String   @id @default(uuid())
  userId          String   @unique
  totalCompleted  Int      @default(0)
  totalFajr       Int      @default(0)
  totalDhuhr      Int      @default(0)
  totalAsr        Int      @default(0)
  totalMaghrib    Int      @default(0)
  totalIsha       Int      @default(0)
  totalJumuah     Int      @default(0)
  totalTarawih    Int      @default(0)
  totalEidFitr    Int      @default(0)
  totalEidAdha    Int      @default(0)
  lastCompletedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_prayer_stats")
}

model StreakFreezeUsage {
  id            String             @id @default(uuid())
  userId        String
  protectedDate DateTime           @db.Date
  usedAt        DateTime           @default(now())
  reason        StreakFreezeReason @default(USER_INITIATED)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, protectedDate])
  @@index([userId, usedAt])
  @@map("streak_freeze_usages")
}
