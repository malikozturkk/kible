# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.
# Every variable below is required; the app throws on boot if any is missing or empty.

# ── Database ─────────────────────────────────────────────────────────────────
# docker-compose.yml exposes PostgreSQL on host port 5434 with db name "kible".
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/kible

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing secret for access tokens AND the 10-minute registration temp token.
JWT_SECRET=
# ms-style duration accepted by @nestjs/jwt, e.g. 15m, 1h, 7d.
JWT_EXPIRES_IN=15m
# Server-side secret concatenated to every password before bcrypt hashing.
# WARNING: changing this invalidates every existing password hash.
PEPPER=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Base URL used to build the password-reset link sent by email AND as the single
# origin allowed by CORS — so it must be the frontend's bare scheme://host:port
# (a path segment would break the CORS match; a trailing slash is stripped).
FRONTEND_BASE_URL=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# OPTIONAL — the one variable here that may stay unset. Pino log level:
# trace | debug | info | warn | error | fatal.
# Unset: "info" when NODE_ENV=production, otherwise "debug".
LOG_LEVEL=

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Express `trust proxy`. Decides which address @nestjs/throttler rate-limits on.
# Empty / unset = trust nothing (correct when the app is exposed directly — the
# safe default, since trusting X-Forwarded-For with no proxy lets any client
# spoof its IP and reset its own rate limit).
# Behind a proxy set either the hop count (Nginx/ALB in front => 1) or a
# comma-separated list of trusted IPs/CIDRs/loopback/linklocal/uniquelocal.
# Anything unparseable throws at boot.
TRUST_PROXY=

# ── Consent versions ─────────────────────────────────────────────────────────
# Bumping a version forces every user to re-accept that document.
CONSENT_VERSION_TERMS_OF_SERVICE=1.0.0
CONSENT_VERSION_PRIVACY_POLICY=1.0.0
CONSENT_VERSION_SPECIAL_CATEGORY_DATA=1.0.0

# ── Mailjet (transactional email) ────────────────────────────────────────────
# Real emails are sent from a dev environment too — use test addresses.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=NamazGo
# Numeric Mailjet template IDs.
MAILJET_OTP_TEMPLATE_ID=
MAILJET_FORGOT_PASSWORD_TEMPLATE_ID=
